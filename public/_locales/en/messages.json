  "actionTitle": {
    "message": "What to do with listed accounts"
  },
  "actionBlock": {
    "message": "Block from my feed (recommended)"
  },
  "actionBlockHelp": {
    "message": "When a post from a listed account reaches the screen, it is collapsed, then the account is blocked through X's own \"Block\" menu, with your session. A block made from a post on screen weighs on what X recommends: it counts as a negative signal for that account."
  },
  "actionHide": {
    "message": "Hide only"
  },
  "actionHideHelp": {
    "message": "Posts are collapsed, nothing is sent to X."
  },
  "actionPace": {
    "message": "Pace: at most $HOUR$ blocks per hour and $DAY$ per day, with a pause of $MIN$ to $MAX$ seconds between two. Blocks happen one at a time, only on posts on screen, never in the background.",
    "placeholders": {
      "hour": {
        "content": "$1"
      },
      "day": {
        "content": "$2"
      },
      "min": {
        "content": "$3"
      },
      "max": {
        "content": "$4"
      }
    }
  },
  "actionRisk": {
    "message": "X forbids bulk automated actions. This pace mimics a person blocking while reading their feed, but it is your account that blocks: the choice is yours. A block can be undone in X's settings (\"Blocked accounts\")."
  },
  "whatsNew": {
    "message": "New in version 0.5: the extension can block listed accounts from your feed. It is the default; choose \"Hide only\" if you want nothing sent to X."
  },
